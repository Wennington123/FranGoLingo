{
  "expo": {
    "name": "FranGoLingo",
    "slug": "frangolingo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "android": {
      "package": "app.frangolingo",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563eb"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.frangolingo"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
